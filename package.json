{
  "name": "google-messages-windows-arm",
  "productName": "Messages",
  "version": "1.0.1",
  "description": "Google Messages desktop app for Windows on ARM (Snapdragon X), with an x64 build too",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "build": "electron-builder --win --arm64",
    "build:arm64": "electron-builder --win --arm64",
    "build:x64": "electron-builder --win --x64",
    "dist": "electron-builder --win",
    "generate-ico": "node scripts/generate-ico.js"
  },
  "keywords": [
    "google",
    "messages",
    "sms",
    "rcs",
    "electron",
    "windows",
    "arm64",
    "snapdragon"
  ],
  "author": "Dustin Olenslager",
  "license": "MIT",
  "dependencies": {
    "electron-auto-launch": "^5.0.6",
    "electron-log": "^5.1.2",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3"
  }
}
